# MySQL
MYSQL_DATABASE=earthy_shop
MYSQL_ROOT_PASSWORD=your-root-password
MYSQL_USER=earthy_user
MYSQL_PASSWORD=your-mysql-password
MYSQL_PORT=3306

# Backend database account
# Docker compose에서는 DB_URL을 mysql 컨테이너 주소로 덮어쓴다.
DB_URL=jdbc:mysql://localhost:3306/earthy_shop?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=earthy_user
DB_PASSWORD=change-this-db-password
DB_DRIVER=com.mysql.cj.jdbc.Driver
JPA_DDL_AUTO=update

# Server ports
SERVER_PORT=8080
BACKEND_PORT=8080
FRONTEND_PORT=5175

# Production deploy image
BACKEND_IMAGE=your-account-id.dkr.ecr.ap-northeast-2.amazonaws.com/earthy-shop-backend:latest

# Admin
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-admin-password
ADMIN_SYNC_PASSWORD=false

# JWT
# Base64로 인코딩된 충분히 긴 secret을 넣는다.
JWT_SECRET=your-base64-secret
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000

# Brevo email
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_NAME=EARTHY
BREVO_SENDER_EMAIL=your-sender-email@example.com

# Solapi Kakao Alimtalk
SOLAPI_ENABLED=false
SOLAPI_API_KEY=your-solapi-api-key
SOLAPI_API_SECRET=your-solapi-api-secret
SOLAPI_PF_ID=your-solapi-pf-id
SOLAPI_SENDER_PHONE=your-sender-phone
SOLAPI_TEMPLATE_ORDER_COMPLETED=CSyWfShCxc
SOLAPI_TEMPLATE_SHIPPING_STARTED=pbG21XKt4k
SOLAPI_TEMPLATE_CANCELED_CUSTOMER=nIhm45TDnd
SOLAPI_TEMPLATE_CANCELED_ADMIN=C18mLD5LP8

# AWS S3 image upload
AWS_S3_ACCESS_KEY=your-aws-access-key
AWS_S3_SECRET_KEY=your-aws-secret-key
AWS_S3_REGION=ap-northeast-2
AWS_S3_BUCKET=your-s3-bucket
AWS_S3_PUBLIC_BASE_URL=https://your-s3-bucket.s3.ap-northeast-2.amazonaws.com

# Kakao OAuth
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_REDIRECT_URI=https://api.earthy-shop.com/api/oauth/kakao/callback
KAKAO_FRONTEND_REDIRECT_URI=https://earthy-shop.com/auth

# PortOne V2
PORTONE_STORE_ID=your-portone-store-id
PORTONE_CHANNEL_KEY=your-portone-channel-key
PORTONE_API_SECRET=your-portone-api-secret

# Frontend build variables
VITE_API_BASE_URL=https://api.earthy-shop.com
VITE_PORTONE_STORE_ID=your-portone-store-id
VITE_PORTONE_CHANNEL_KEY=your-portone-channel-key
VITE_PORTONE_REDIRECT_URL=https://earthy-shop.com
